# Serves the static web build (LND-WEB-01, LND-WEB-05).
:8081 {
	root * /srv
	encode zstd gzip
	@listing path_regexp ^/listings/[^/]+$
	rewrite @listing /listings/[id].html
	try_files {path} {path}.html /index.html
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	file_server
}
